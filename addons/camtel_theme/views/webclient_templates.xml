<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <!-- Override web.layout to change page title from Odoo to Camtel_SMS -->
    <template id="layout_camtel" inherit_id="web.layout">
        <xpath expr="//title" position="replace">
            <title t-esc="title or 'Camtel_SMS'"/>
        </xpath>
    </template>

    <!-- Override web.login_layout to change "Powered by Odoo" to "Powered by Camtel_SMS" and remove Manage Databases -->
    <template id="login_layout_camtel" inherit_id="web.login_layout">
        <!-- Replace the Manage Databases and Powered by Odoo footer -->
        <xpath expr="//div[@class='text-center small mt-4 pt-3 border-top']" position="replace">
            <div class="text-center small mt-4 pt-3 border-top" t-if="not disable_footer">
                <a href="/" target="_blank">Powered by <span style="font-weight: bold; color: #09AEEF;">Camtel_SMS</span></a>
            </div>
        </xpath>
    </template>

    <!-- Override brand promotion message to show Camtel_SMS instead of Odoo -->
    <template id="brand_promotion_message_camtel" inherit_id="web.brand_promotion_message">
        <xpath expr="//t[@t-set='odoo_logo']" position="replace">
            <t t-set="odoo_logo">
                <span class="badge text-bg-light" style="color: #09AEEF; font-weight: bold; text-decoration: none;">
                    Camtel_SMS
                </span>
            </t>
        </xpath>
    </template>

    <!-- Override frontend layout to change page title -->
    <template id="frontend_layout_camtel" inherit_id="web.frontend_layout">
        <xpath expr="//title" position="replace">
            <title t-esc="title or 'Camtel_SMS'"/>
        </xpath>
    </template>
</odoo>
<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <!-- Purchase Analytics Search View -->
    <record id="view_camtel_purchase_analytics_search" model="ir.ui.view">
        <field name="name">camtel.purchase.analytics.search</field>
        <field name="model">camtel.purchase.analytics</field>
        <field name="arch" type="xml">
            <search string="Purchase Analysis">
                <filter string="RFQ" name="rfq"
                        domain="[('state', 'in', ['draft', 'sent'])]"/>
                <filter string="To Approve" name="to_approve"
                        domain="[('state', '=', 'to approve')]"/>
                <filter string="Purchase Order" name="purchase_order"
                        domain="[('state', '=', 'purchase')]"/>
                <filter string="Done" name="done"
                        domain="[('state', '=', 'done')]"/>
                <separator/>
                <filter string="This Month" name="this_month"
                        domain="[('order_date', '&gt;=', (context_today() - relativedelta(day=1)).strftime('%Y-%m-%d'))]"/>
                <filter string="This Year" name="this_year"
                        domain="[('order_date', '&gt;=', (context_today() - relativedelta(month=1, day=1)).strftime('%Y-%m-%d'))]"/>
                <separator/>
                <filter string="Vendor" name="group_by_vendor"
                        context="{'group_by': 'partner_id'}"/>
                <filter string="Purchase Rep" name="group_by_user"
                        context="{'group_by': 'user_id'}"/>
                <filter string="Product" name="group_by_product"
                        context="{'group_by': 'product_id'}"/>
                <filter string="Category" name="group_by_category"
                        context="{'group_by': 'category_id'}"/>
                <filter string="Status" name="group_by_state"
                        context="{'group_by': 'state'}"/>
                <filter string="Order Month" name="group_by_month"
                        context="{'group_by': 'order_date:month'}"/>
                <filter string="Order Year" name="group_by_year"
                        context="{'group_by': 'order_date:year'}"/>
                <field name="order_id"/>
                <field name="partner_id"/>
                <field name="product_id"/>
                <field name="category_id"/>
                <field name="user_id"/>
            </search>
        </field>
    </record>

    <!-- Purchase Analytics Graph View - Bar Chart -->
    <record id="view_camtel_purchase_analytics_graph" model="ir.ui.view">
        <field name="name">camtel.purchase.analytics.graph</field>
        <field name="model">camtel.purchase.analytics</field>
        <field name="arch" type="xml">
            <graph string="Purchase Analysis" type="bar" sample="1">
                <field name="order_date" interval="month"/>
                <field name="price_total" type="measure"/>
                <field name="quantity" type="measure"/>
            </graph>
        </field>
    </record>

    <!-- Purchase Analytics Graph View - Line Chart -->
    <record id="view_camtel_purchase_analytics_graph_line" model="ir.ui.view">
        <field name="name">camtel.purchase.analytics.graph.line</field>
        <field name="model">camtel.purchase.analytics</field>
        <field name="arch" type="xml">
            <graph string="Purchase Trends" type="line" sample="1">
                <field name="order_date" interval="month"/>
                <field name="price_total" type="measure"/>
            </graph>
        </field>
    </record>

    <!-- Purchase Analytics Graph View - Pie Chart -->
    <record id="view_camtel_purchase_analytics_graph_pie" model="ir.ui.view">
        <field name="name">camtel.purchase.analytics.graph.pie</field>
        <field name="model">camtel.purchase.analytics</field>
        <field name="arch" type="xml">
            <graph string="Purchase by Vendor" type="pie" sample="1">
                <field name="partner_id"/>
                <field name="price_total" type="measure"/>
            </graph>
        </field>
    </record>

    <!-- Purchase Analytics Pivot View -->
    <record id="view_camtel_purchase_analytics_pivot" model="ir.ui.view">
        <field name="name">camtel.purchase.analytics.pivot</field>
        <field name="model">camtel.purchase.analytics</field>
        <field name="arch" type="xml">
            <pivot string="Purchase Analysis" sample="1">
                <field name="partner_id" type="row"/>
                <field name="order_date" interval="month" type="col"/>
                <field name="price_total" type="measure"/>
                <field name="quantity" type="measure"/>
                <field name="qty_received" type="measure"/>
                <field name="delay" type="measure"/>
            </pivot>
        </field>
    </record>

    <!-- Purchase Analytics List View -->
    <record id="view_camtel_purchase_analytics_list" model="ir.ui.view">
        <field name="name">camtel.purchase.analytics.list</field>
        <field name="model">camtel.purchase.analytics</field>
        <field name="arch" type="xml">
            <list string="Purchase Details" create="false" delete="false" sample="1"
                  decoration-info="state == 'draft'"
                  decoration-warning="state == 'to approve'"
                  decoration-success="state == 'purchase'">
                <field name="order_date"/>
                <field name="order_id"/>
                <field name="partner_id"/>
                <field name="product_id"/>
                <field name="category_id"/>
                <field name="quantity" sum="Total Qty"/>
                <field name="qty_received" sum="Total Received"/>
                <field name="unit_price" avg="Avg Price"/>
                <field name="price_total" sum="Total Amount"/>
                <field name="state"/>
                <field name="delay" avg="Avg Delay (days)"/>
                <field name="currency_id" column_invisible="1"/>
            </list>
        </field>
    </record>

    <!-- Purchase Analytics Action -->
    <record id="action_camtel_purchase_analytics" model="ir.actions.act_window">
        <field name="name">Purchase Analysis</field>
        <field name="res_model">camtel.purchase.analytics</field>
        <field name="view_mode">graph,pivot,list</field>
        <field name="context">{'search_default_this_year': 1, 'search_default_group_by_month': 1}</field>
        <field name="help" type="html">
            <p class="o_view_nocontent_empty_folder">
                No purchase data available
            </p>
            <p>
                Purchase order analytics will appear here once you have purchase orders.
            </p>
        </field>
    </record>
</odoo>

<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <!-- Stock Analytics Search View -->
    <record id="view_camtel_stock_analytics_search" model="ir.ui.view">
        <field name="name">camtel.stock.analytics.search</field>
        <field name="model">camtel.stock.analytics</field>
        <field name="arch" type="xml">
            <search string="Inventory Analysis">
                <filter string="Low Stock" name="low_stock"
                        domain="[('quantity', '&lt;', 10), ('quantity', '&gt;', 0)]"/>
                <filter string="Out of Stock" name="out_of_stock"
                        domain="[('quantity', '&lt;=', 0)]"/>
                <filter string="In Stock" name="in_stock"
                        domain="[('quantity', '&gt;', 0)]"/>
                <separator/>
                <filter string="Has Incoming" name="has_incoming"
                        domain="[('incoming_quantity', '&gt;', 0)]"/>
                <filter string="Has Outgoing" name="has_outgoing"
                        domain="[('outgoing_quantity', '&gt;', 0)]"/>
                <separator/>
                <filter string="Product" name="group_by_product"
                        context="{'group_by': 'product_id'}"/>
                <filter string="Product Template" name="group_by_template"
                        context="{'group_by': 'product_tmpl_id'}"/>
                <filter string="Category" name="group_by_category"
                        context="{'group_by': 'category_id'}"/>
                <filter string="Warehouse" name="group_by_warehouse"
                        context="{'group_by': 'warehouse_id'}"/>
                <filter string="Location" name="group_by_location"
                        context="{'group_by': 'location_id'}"/>
                <field name="product_id"/>
                <field name="category_id"/>
                <field name="warehouse_id"/>
                <field name="location_id"/>
            </search>
        </field>
    </record>

    <!-- Stock Analytics Graph View -->
    <record id="view_camtel_stock_analytics_graph" model="ir.ui.view">
        <field name="name">camtel.stock.analytics.graph</field>
        <field name="model">camtel.stock.analytics</field>
        <field name="arch" type="xml">
            <graph string="Inventory Analysis" type="bar" sample="1">
                <field name="category_id"/>
                <field name="quantity" type="measure"/>
                <field name="inventory_value" type="measure"/>
                <field name="available_quantity" type="measure"/>
            </graph>
        </field>
    </record>

    <!-- Stock Analytics Pivot View -->
    <record id="view_camtel_stock_analytics_pivot" model="ir.ui.view">
        <field name="name">camtel.stock.analytics.pivot</field>
        <field name="model">camtel.stock.analytics</field>
        <field name="arch" type="xml">
            <pivot string="Inventory Analysis" sample="1">
                <field name="category_id" type="row"/>
                <field name="warehouse_id" type="col"/>
                <field name="quantity" type="measure"/>
                <field name="inventory_value" type="measure"/>
                <field name="available_quantity" type="measure"/>
                <field name="incoming_quantity" type="measure"/>
                <field name="outgoing_quantity" type="measure"/>
            </pivot>
        </field>
    </record>

    <!-- Stock Analytics List View -->
    <record id="view_camtel_stock_analytics_list" model="ir.ui.view">
        <field name="name">camtel.stock.analytics.list</field>
        <field name="model">camtel.stock.analytics</field>
        <field name="arch" type="xml">
            <list string="Inventory Details" create="false" delete="false" sample="1"
                  decoration-danger="quantity &lt;= 0"
                  decoration-warning="quantity &gt; 0 and quantity &lt; 10">
                <field name="product_id"/>
                <field name="category_id"/>
                <field name="warehouse_id"/>
                <field name="quantity" sum="Total Quantity"/>
                <field name="available_quantity" sum="Total Available"/>
                <field name="incoming_quantity" sum="Total Incoming"/>
                <field name="outgoing_quantity" sum="Total Outgoing"/>
                <field name="inventory_value" sum="Total Value"/>
                <field name="currency_id" column_invisible="1"/>
            </list>
        </field>
    </record>

    <!-- Stock Analytics Action -->
    <record id="action_camtel_stock_analytics" model="ir.actions.act_window">
        <field name="name">Inventory Analysis</field>
        <field name="res_model">camtel.stock.analytics</field>
        <field name="view_mode">graph,pivot,list</field>
        <field name="context">{'search_default_in_stock': 1, 'search_default_group_by_category': 1}</field>
        <field name="help" type="html">
            <p class="o_view_nocontent_empty_folder">
                No inventory data available
            </p>
            <p>
                Inventory analytics will appear here once you have stock in your warehouses.
            </p>
        </field>
    </record>
</odoo>
